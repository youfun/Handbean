<div id="mcp-settings" class="settings-content-wrap h-full overflow-y-auto">
  <div class="settings-content-card">
    <div class="mcp-settings-header">
      <div>
        <div class="settings-section-title">{gettext("MCP Servers")}</div>
        <div class="settings-help-text">
          {gettext("Connect HTTP MCP servers and control workspace access.")}
        </div>
      </div>
      <button id="mcp-add" type="button" phx-click="new" class="settings-btn settings-btn-primary">
        {gettext("Add server")}
      </button>
    </div>

    <div :if={@load_error} id="mcp-load-error" class="settings-help-text text-red-600 mb-3">
      {@load_error}
    </div>

    <!-- Empty State -->
    <div
      :if={!@load_error && @servers == []}
      id="mcp-empty"
      class="settings-empty-state"
    >
      <p>{gettext("No MCP servers configured.")}</p>
      <p class="settings-field-desc">
        {gettext("Connect a server to make its tools available to approved workspaces.")}
      </p>
    </div>

    <!-- Server List -->
    <div :if={@servers != []} id="mcp-server-list" class="space-y-3">
      <div
        :for={server <- @servers}
        id={"mcp-server-#{server.id}"}
        class="settings-card p-4 transition-colors hover:border-[var(--sig-border-default,#b7bbc1)]"
      >
        <div class="flex items-start justify-between gap-3">
          <button
            type="button"
            phx-click="edit"
            phx-value-id={server.id}
            class="text-left min-w-0 flex-1 group"
          >
            <div class="settings-field-title font-semibold text-base group-hover:text-primary transition-colors">
              {server.name}
            </div>
            <div class="settings-field-desc text-xs mt-1">
              {server.transport} · {if server.disabled,
                do: gettext("Disabled"),
                else: gettext("Enabled")} · {server.tool_count} {gettext("tools")}
            </div>
            <div class="settings-field-desc text-xs mt-0.5">
              <span class={
                if server.status == :connected,
                  do: "text-green-600 font-medium",
                  else: "text-secondary"
              }>
                {if server.status == :connected,
                  do: "● " <> gettext("Connected"),
                  else: "○ " <> gettext("Not connected")}
              </span>
            </div>
          </button>
          <div class="flex items-center gap-2">
            <button
              type="button"
              phx-click="confirm_delete"
              phx-value-id={server.id}
              class="settings-btn settings-btn-danger text-xs text-red-600"
            >
              {gettext("Delete")}
            </button>
          </div>
        </div>
        <div
          :if={server.transport == :stdio}
          class="settings-help-text text-xs mt-2 pt-2 border-t border-subtle"
        >
          {gettext(
            "This stdio server comes from %{source}. Edit its source configuration to change how it launches.",
            source: server.source
          )}
        </div>
        <div
          :if={@delete_target == server.id}
          id={"mcp-delete-confirm-#{server.id}"}
          class="mt-3 pt-3 border-t border-subtle flex items-center gap-2 text-xs"
        >
          <span class="text-secondary">{gettext("Delete this server?")}</span>
          <button
            type="button"
            phx-click="delete"
            phx-value-id={server.id}
            class="settings-btn settings-btn-danger text-xs font-semibold text-red-600"
          >
            {gettext("Delete")}
          </button>
          <button type="button" phx-click="cancel_delete" class="settings-btn text-xs">
            {gettext("Cancel")}
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- ── Add / Edit Server Modal Overlay ── -->
  <div :if={@form} class="settings-overlay">
    <div class="settings-dialog settings-dialog-md" phx-click-away="cancel">
      <div class="flex items-center justify-between mb-4">
        <h2 class="settings-dialog-title" style="margin: 0;">
          <%= if @form["id"] in [nil, ""] do %>
            {gettext("Add MCP Server")}
          <% else %>
            {gettext("Edit MCP Server")}
          <% end %>
        </h2>
        <button
          type="button"
          phx-click="cancel"
          class="text-secondary hover:text-primary p-1 text-sm leading-none cursor-pointer"
          title={gettext("Cancel")}
        >
          ✕
        </button>
      </div>

      <form
        id="mcp-server-form"
        phx-change="change"
        phx-submit="save"
        class="space-y-4"
      >
        <input type="hidden" name="server[id]" value={@form["id"] || ""} />
        <%= if @editing_transport == :stdio do %>
          <div class="settings-help-text text-xs">
            {gettext(
              "stdio servers are read-only here. Edit the source configuration to change the launcher."
            )}
          </div>
          <div class="settings-dialog-actions pt-2">
            <button type="button" phx-click="cancel" class="settings-btn">
              {gettext("Cancel")}
            </button>
          </div>
        <% else %>
          <div class="settings-form-group">
            <label class="settings-form-label">{gettext("Name")}</label>
            <input
              class="settings-input"
              name="server[name]"
              value={@form["name"]}
              required
              placeholder={gettext("e.g. My MCP Server")}
            />
          </div>

          <div class="settings-form-group">
            <label class="settings-form-label">{gettext("URL")}</label>
            <input
              class="settings-input"
              name="server[url]"
              value={@form["url"]}
              type="url"
              required
              placeholder="https://..."
            />
          </div>

          <div class="settings-form-group">
            <label class="settings-form-label">{gettext("Authentication")}</label>
            <select class="settings-input" name="server[auth]">
              <option value="none" selected={@form["auth"] == "none"}>{gettext("None")}</option>
              <option value="bearer" selected={@form["auth"] == "bearer"}>
                {gettext("Bearer token")}
              </option>
              <option value="headers" selected={@form["auth"] == "headers"}>
                {gettext("Custom headers")}
              </option>
            </select>
          </div>

          <div :if={@form["auth"] == "bearer"} class="settings-form-group">
            <label class="settings-form-label">{gettext("Token")}</label>
            <input
              class="settings-input"
              name="server[token]"
              value={@form["token"]}
              type="password"
              placeholder={
                if @form["has_credentials"],
                  do: gettext("Leave blank to keep saved token"),
                  else: ""
              }
            />
          </div>

          <div :if={@form["auth"] == "headers"} class="settings-form-group">
            <label class="settings-form-label">{gettext("Headers (JSON)")}</label>
            <textarea
              class="settings-input"
              rows="3"
              name="server[headers_json]"
              placeholder={
                if @form["has_credentials"],
                  do: gettext("Leave blank to keep saved headers"),
                  else: ~s({"Authorization": "Bearer ..."})
              }
            >{@form["headers_json"]}</textarea>
          </div>

          <div class="settings-form-group">
            <label class="flex items-center gap-2 text-xs text-secondary cursor-pointer">
              <input
                type="checkbox"
                name="server[disabled]"
                value="true"
                checked={@form["disabled"]}
              />
              <span>{gettext("Disabled")}</span>
            </label>
          </div>

          <div class="settings-form-group">
            <label class="settings-form-label">{gettext("Workspace access")}</label>
            <div class="space-y-1.5 mt-1">
              <label class="flex items-center gap-2 text-xs text-secondary cursor-pointer">
                <input
                  type="radio"
                  name="server[access_mode]"
                  value="all"
                  checked={@form["access_mode"] == "all"}
                />
                <span>{gettext("All workspaces, including future workspaces")}</span>
              </label>
              <div>
                <label class="flex items-center gap-2 text-xs text-secondary cursor-pointer">
                  <input
                    type="radio"
                    name="server[access_mode]"
                    value="selected"
                    checked={@form["access_mode"] != "all"}
                  />
                  <span>{gettext("Selected workspaces")}</span>
                </label>
                <div
                  :if={@form["access_mode"] != "all"}
                  class="mt-1.5 ml-6 space-y-1.5"
                >
                  <label
                    :for={workspace <- @workspaces}
                    class="flex items-center gap-2 text-xs text-secondary cursor-pointer"
                  >
                    <input
                      type="checkbox"
                      name="server[workspace_ids][]"
                      value={workspace["id"]}
                      checked={workspace["id"] in @form["workspace_ids"]}
                    />
                    <span>{workspace["name"]}</span>
                  </label>
                </div>
              </div>
            </div>
          </div>

          <div
            :if={@form_error}
            id="mcp-form-error"
            class="p-2.5 rounded-lg text-xs text-red-600 bg-red-50 dark:bg-red-950/30 border border-red-200 dark:border-red-900/50"
          >
            {@form_error}
          </div>

          <div :if={@test_result} id="mcp-test-result" class="text-xs">
            <%= case @test_result do %>
              <% {:ok, %{tool_count: count}} -> %>
                <span class="text-green-600 font-medium">✓ {gettext(
                  "Connected. %{count} tools found.",
                  count: count
                )}</span>
              <% {:error, reason} -> %>
                <span class="text-red-600 font-medium">⚠ {reason}</span>
            <% end %>
          </div>

          <div class="settings-dialog-actions pt-2">
            <button
              type="button"
              phx-click="test_connection"
              disabled={@testing}
              class="settings-btn mr-auto"
            >
              {if @testing, do: gettext("Testing..."), else: gettext("Test connection")}
            </button>
            <button type="button" phx-click="cancel" class="settings-btn">
              {gettext("Cancel")}
            </button>
            <button type="submit" class="settings-btn settings-btn-primary">
              {gettext("Save")}
            </button>
          </div>
        <% end %>
      </form>
    </div>
  </div>
</div>
