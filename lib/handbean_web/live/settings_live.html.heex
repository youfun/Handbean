<!-- Unified Settings Page — full-screen, matches workspace visual style -->
<div class="h-screen flex flex-col bg-main text-primary settings-page-shell">
  <Layouts.flash_group flash={@flash} />
  <div
    :if={@runtime_banner}
    id="runtime-banner"
    class="px-3 py-2 text-xs text-secondary border-b bg-surface"
  >
    {@runtime_banner}
  </div>
  <!-- Toast Notification -->
  <div
    :if={@toast}
    id={"toast-#{@toast.id}"}
    class={"toast-notification #{if @toast.type == :error, do: "toast-error", else: ""}"}
  >
    <span :if={@toast.type == :success} class="flex-shrink-0 font-bold">✓</span>
    <span :if={@toast.type == :error} class="flex-shrink-0 font-bold font-mono">⚠</span>
    <span>{@toast.message}</span>
  </div>

  <!-- Top bar with back link -->
  <div class="settings-topbar h-9 border-b bg-surface flex items-center px-3 flex-shrink-0 gap-2">
    <a
      href={
        if @conversation_id,
          do: ~p"/w/#{@return_workspace_id}/c/#{@conversation_id}",
          else: ~p"/"
      }
      class="settings-back-link text-secondary hover:text-primary transition-colors flex items-center gap-1.5 no-underline"
    >
      <span aria-hidden="true">←</span>
      <span>{gettext("返回工作台")}</span>
    </a>
    <span class="settings-topbar-title text-xs font-semibold text-primary">
      <img src={~p"/images/logo.svg"} class="brand-mark" width="16" height="16" alt="" />
      {gettext("Settings")}
    </span>
  </div>

  <!-- Main content: left menu + right panel -->
  <div class="flex flex-1 overflow-hidden settings-page-main">
    <!-- Left: Settings Menu -->
    <div
      id="settings-menu"
      class="settings-sidebar flex-shrink-0 border-r bg-surface flex flex-col"
      phx-hook="SettingsNav"
    >
      <div class="pt-3 pb-2 px-3">
        <h2 class="projects-panel-title">{gettext("Settings")}</h2>
      </div>
      <div class="flex-1">
        <button
          :for={item <- @tabs}
          phx-click="select_tab"
          phx-value-tab={item.id}
          aria-current={if @active_tab == item.id, do: "page", else: nil}
          class={[
            "settings-menu-item w-full text-left px-3 py-2 text-xs flex items-center gap-2 transition-colors",
            if(@active_tab == item.id,
              do: "settings-menu-item-active text-primary",
              else: "text-secondary hover:bg-surface-hover"
            )
          ]}
        >
          <span>{tab_label(item.id)}</span>
        </button>
      </div>
      <div id="settings-app-version" class="settings-app-version">
        <span>Handbean v{@app_version}</span>
        <a
          id="settings-source-link"
          href="https://github.com/youfun/Handbean"
          target="_blank"
          rel="noopener noreferrer"
          class="settings-source-link"
          aria-label="GitHub"
          title="GitHub"
        >
          <svg
            class="settings-source-icon"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path d="M12 .7a11.5 11.5 0 0 0-3.64 22.41c.58.11.79-.25.79-.56v-2.02c-3.22.7-3.9-1.55-3.9-1.55-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.71.08-.71 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.71 1.26 3.37.96.1-.75.4-1.26.73-1.55-2.57-.29-5.27-1.29-5.27-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.47.11-3.06 0 0 .97-.31 3.16 1.18a10.97 10.97 0 0 1 5.76 0c2.2-1.49 3.16-1.18 3.16-1.18.63 1.59.23 2.77.11 3.06.74.81 1.19 1.84 1.19 3.1 0 4.42-2.71 5.39-5.29 5.68.42.36.79 1.07.79 2.16v3.2c0 .31.21.68.8.56A11.5 11.5 0 0 0 12 .7Z" />
          </svg>
        </a>
      </div>
    </div>

    <!-- Right: Content Panel (flex-1) -->
    <div class="settings-page-content flex-1 overflow-y-auto bg-main">
      <!-- Model / AI Tab — reuse existing ModelAIPanel component -->
      <div :if={@active_tab == :model_ai} class="settings-content-wrap">
        <div class="settings-content-card">
          <ModelAIPanel.render
            form={@form}
            available_models={@available_models}
            errors={@errors}
            scope={:global}
          />

          <div class="settings-page-actions">
            <button
              phx-click="save_settings"
              disabled={@saving}
              class="settings-save-btn"
            >
              {if @saving, do: gettext("Saving..."), else: gettext("Save")}
            </button>
          </div>
        </div>
      </div>

      <!-- Workspace Models Tab -->
      <div :if={@active_tab == :workspace_models} class="settings-content-wrap">
        <div class="settings-content-card">
          <div class="settings-form-section">
            <div class="settings-workspace-heading">
              <div class="settings-section-heading">
                <div class="settings-section-title">{gettext("当前工作区模型")}</div>
                <div class="settings-help-text">
                  <div>{@workspace["name"]}</div>
                  <div class="settings-path">{@workspace_root}</div>
                </div>
              </div>

              <form
                id="workspace-models-workspace-form"
                phx-change="select_workspace_models"
                class="settings-workspace-select"
              >
                <label class="sr-only" for="workspace-models-workspace">
                  {gettext("选择工作区")}
                </label>
                <select
                  id="workspace-models-workspace"
                  name="workspace[id]"
                  class="settings-input"
                >
                  <option
                    :for={workspace <- @workspaces}
                    value={workspace["id"]}
                    selected={@workspace["id"] == workspace["id"]}
                  >
                    {workspace["name"]}
                  </option>
                </select>
              </form>
            </div>

            <div class="settings-card">
              <div class="settings-field-row">
                <div class="settings-field-copy">
                  <div class="settings-field-title">{gettext("访问模式")}</div>
                  <div class="settings-field-desc">
                    {gettext("Limit which models this workspace can use.")}
                  </div>
                </div>
                <div class="settings-field-control">
                  <div class="flex gap-2">
                    <button
                      type="button"
                      phx-click="set_workspace_model_mode"
                      phx-value-mode="unrestricted"
                      class={[
                        "settings-chip",
                        if(@workspace_model_policy.mode == :unrestricted, do: "active")
                      ]}
                    >
                      {gettext("不限制")}
                    </button>
                    <button
                      type="button"
                      phx-click="set_workspace_model_mode"
                      phx-value-mode="restricted"
                      class={[
                        "settings-chip",
                        if(@workspace_model_policy.mode == :restricted, do: "active")
                      ]}
                    >
                      {gettext("仅允许勾选模型")}
                    </button>
                  </div>
                </div>
              </div>

              <form
                id="workspace-default-model-form"
                phx-change="set_workspace_default_model"
                class="settings-field-row"
              >
                <div class="settings-field-copy">
                  <label class="settings-field-title" for="workspace-default-model">
                    {gettext("工作区默认模型")}
                  </label>
                  <div class="settings-field-desc">
                    {gettext("Used when starting a new conversation in this workspace.")}
                  </div>
                </div>
                <div class="settings-field-control">
                  <ModelPicker.render
                    id="workspace-default-model"
                    name="default_model"
                    value={@workspace_model_policy.default_model}
                    options={
                      workspace_default_picker_options(@workspace_model_policy, @all_models)
                    }
                    label={gettext("工作区默认模型")}
                    change="set_workspace_default_model"
                  />
                </div>
              </form>
            </div>

            <div
              :if={@workspace_model_policy.mode == :restricted}
              class="settings-model-picker-list"
            >
              <form
                id="workspace-model-filter-form"
                phx-change="filter_workspace_models"
                class="settings-model-filter"
              >
                <label class="sr-only" for="workspace-model-filter">{gettext("搜索模型")}</label>
                <input
                  id="workspace-model-filter"
                  type="search"
                  name="query"
                  value={@workspace_model_query}
                  placeholder={gettext("搜索模型或供应商")}
                  phx-debounce="200"
                  class="settings-input"
                />
              </form>

              <div class="settings-model-list">
                <div
                  :for={
                    {provider_id, models} <-
                      filtered_models_grouped_by_provider(@all_models, @workspace_model_query)
                  }
                  class="settings-model-provider"
                >
                  <div class="settings-model-provider-header">
                    <div>
                      <div class="settings-model-provider-title">{provider_id}</div>
                      <div class="settings-model-provider-count">
                        {gettext("已选 %{selected} / %{total}",
                          selected:
                            workspace_provider_selected_count(
                              @workspace_model_policy,
                              provider_id
                            ),
                          total: workspace_provider_model_count(@all_models, provider_id)
                        )}
                      </div>
                    </div>
                    <div class="settings-model-provider-actions">
                      <button
                        type="button"
                        phx-click="set_workspace_provider_models"
                        phx-value-provider={provider_id}
                        phx-value-action="all"
                        class="settings-btn"
                      >
                        {gettext("全选")}
                      </button>
                      <button
                        type="button"
                        phx-click="set_workspace_provider_models"
                        phx-value-provider={provider_id}
                        phx-value-action="none"
                        class="settings-btn"
                      >
                        {gettext("清空")}
                      </button>
                    </div>
                  </div>
                  <label :for={model <- models} class="settings-model-row">
                    <input
                      type="checkbox"
                      checked={
                        workspace_model_checked?(
                          @workspace_model_policy,
                          provider_id,
                          model.model_id
                        )
                      }
                      phx-click="toggle_workspace_model"
                      phx-value-provider={provider_id}
                      phx-value-model={model.model_id}
                    />
                    <span>{model.name || model.model_id}</span>
                  </label>
                </div>
              </div>

              <div
                :if={
                  filtered_models_grouped_by_provider(@all_models, @workspace_model_query) == []
                }
                class="settings-model-empty"
              >
                {gettext("没有匹配的模型")}
              </div>
            </div>
          </div>

          <div class="settings-page-actions">
            <button
              phx-click="save_workspace_models"
              disabled={@workspace_models_saving}
              class="settings-save-btn"
            >
              {if @workspace_models_saving, do: gettext("Saving..."), else: gettext("Save")}
            </button>
          </div>
        </div>
      </div>

      <!-- Workspace Memory Tab — nested LiveView via live_render -->
      <div :if={@active_tab == :workspace_memory} class="flex-1 overflow-hidden">
        {live_render(@socket, HandbeanWeb.WorkspaceMemoryLive,
          id: "settings-workspace-memory",
          session: %{"workspace_id" => @workspace["id"]}
        )}
      </div>

      <!-- Available Models Tab — nested LiveView via live_render -->
      <div :if={@active_tab == :available_models} class="flex-1 overflow-hidden">
        {live_render(@socket, HandbeanWeb.AvailableModelsLive,
          id: "settings-available-models",
          session: %{"embedded" => "true"}
        )}
      </div>

      <!-- Advanced settings: local voice input and diagnostics. -->
      <div :if={@active_tab == :local_webgpu} class="settings-content-wrap">
        <div class="settings-content-card settings-form-section">
          <div class="settings-section-heading">
            <div class="settings-section-title">{gettext("Local voice input")}</div>
            <div class="settings-help-text">
              {gettext(
                "Transcribes on this device with a multilingual Whisper model. Recordings are not sent to a speech service."
              )}
            </div>
          </div>

          <div id="speech-settings" class="settings-card">
            <div class="settings-field-row">
              <div class="settings-field-copy">
                <div class="settings-field-title">{gettext("Enable voice input")}</div>
                <div class="settings-field-desc">
                  {gettext(
                    "Shows a microphone inside the message input after the local model is ready."
                  )}
                </div>
              </div>
              <div class="settings-field-control">
                <button
                  id="speech-enabled-toggle"
                  type="button"
                  phx-click="toggle_speech"
                  disabled={!@speech_supported || speech_status_busy?(@speech_status)}
                  class="settings-toggle-button speech-settings-toggle"
                  role="switch"
                  aria-checked={to_string(@speech_enabled)}
                  aria-label={gettext("Enable voice input")}
                >
                  <span class="settings-toggle-track" aria-hidden="true">
                    <span class="settings-toggle-thumb"></span>
                  </span>
                </button>
              </div>
            </div>

            <div class="settings-field-row">
              <div class="settings-field-copy">
                <div class="settings-field-title">
                  {gettext("Speech model")}
                  <span class="settings-badge-experimental">
                    {speech_status_label(@speech_enabled, @speech_supported, @speech_status)}
                  </span>
                </div>
                <div class="settings-field-desc">
                  {@speech_model.filename} · {format_speech_model_size(@speech_model.size_bytes)} · {gettext(
                    "Chinese and English"
                  )}
                </div>
              </div>
              <div
                :if={@speech_enabled && @speech_supported && speech_status_retry?(@speech_status)}
                class="settings-field-control"
              >
                <button
                  id="speech-model-retry"
                  type="button"
                  phx-click="prepare_speech"
                  class="settings-btn settings-btn-primary"
                >
                  {gettext("Download model")}
                </button>
              </div>
            </div>
          </div>

          <div class="settings-section-heading settings-advanced-divider">
            <div class="settings-section-title">{gettext("Error diagnostics")}</div>
            <div class="settings-help-text">
              {gettext(
                "Download a JSON file to share with a developer. Includes error counts and code locations; excludes messages, conversations, credentials and local paths. Nothing is uploaded."
              )}
            </div>
          </div>
          <form
            id="error-diagnostics-export"
            action={~p"/settings/error-diagnostics"}
            method="get"
            class="settings-card"
          >
            <div class="settings-field-row">
              <label for="diagnostics-range" class="settings-field-title">{gettext("Time range")}</label>
              <select id="diagnostics-range" name="range" class="settings-select">
                <option value="24h">{gettext("Last 24 hours")}</option>
                <option value="7d" selected>{gettext("Last 7 days")}</option>
                <option value="30d">{gettext("Last 30 days")}</option>
                <option value="all">{gettext("All retained history")}</option>
              </select>
            </div>
            <div class="settings-field-row">
              <label for="diagnostics-status" class="settings-field-title">{gettext(
                "Error status"
              )}</label>
              <select id="diagnostics-status" name="status" class="settings-select">
                <option value="unresolved">{gettext("Unresolved")}</option>
                <option value="all">{gettext("All statuses")}</option>
              </select>
            </div>
            <div class="settings-field-row">
              <div class="settings-field-desc">
                {gettext(
                  "Up to 100 error groups and 3 recent occurrences per group. Muted errors are included."
                )}
              </div>
              <button type="submit" class="settings-btn settings-btn-primary">{gettext(
                "Download diagnostics JSON"
              )}</button>
            </div>
          </form>

          <div class="settings-section-heading settings-advanced-divider">
            <div class="settings-section-title">{gettext("Local WebGPU capability probe")}</div>
            <div class="settings-help-text">
              {gettext(
                "Checks the browser boundaries needed by a future local model setting. It does not download or run a model."
              )}
            </div>
          </div>

          <div
            id="local-webgpu-probe"
            class="webgpu-probe"
            phx-hook="LocalWebGPUProbe"
            data-probe-status="running"
            data-status-running={gettext("Running")}
            data-status-ready={gettext("Ready")}
            data-status-unsupported={gettext("Unsupported")}
            data-status-probe-failure={gettext("Probe failed")}
            data-run-running={gettext("Running…")}
            data-run-again={gettext("Run probe again")}
            data-secure-context={gettext("Secure context")}
            data-insecure-context={gettext("Not a secure context")}
          >
            <div class="webgpu-probe-summary">
              <div>
                <div class="webgpu-probe-eyebrow">{gettext("Overall result")}</div>
                <div class="webgpu-probe-status" data-probe-summary>running</div>
              </div>
              <button type="button" class="settings-save-btn" data-probe-run>
                {gettext("Run probe")}
              </button>
            </div>

            <details class="webgpu-probe-details webgpu-probe-diagnostics">
              <summary>{gettext("Technical details")}</summary>
              <div class="webgpu-probe-diagnostics-body">
                <div class="webgpu-probe-meta" data-probe-meta>
                  {gettext("Reading browser capabilities…")}
                </div>

                <div class="webgpu-probe-grid" aria-live="polite">
                  <div
                    :for={
                      {key, label} <- [
                        {"navigator_gpu", "navigator.gpu"},
                        {"adapter", "requestAdapter"},
                        {"device", "requestDevice"},
                        {"compute", "WebGPU compute"},
                        {"shared_worker", "SharedWorker"},
                        {"opfs", "OPFS"}
                      ]
                    }
                    class="webgpu-probe-check"
                    data-probe-check={key}
                    data-status="running"
                  >
                    <div class="webgpu-probe-check-heading">
                      <span data-check-label>{label}</span>
                      <span class="webgpu-probe-check-status" data-check-status>running</span>
                    </div>
                    <div class="webgpu-probe-check-detail" data-check-detail>
                      {gettext("Waiting for probe…")}
                    </div>
                  </div>
                </div>

                <details class="webgpu-probe-details webgpu-probe-json">
                  <summary>{gettext("Structured result")}</summary>
                  <pre data-probe-json>{gettext("Probe is running…")}</pre>
                </details>
              </div>
            </details>

            <p class="webgpu-probe-caveat">
              {gettext(
                "A ready result proves API access and one tiny compute dispatch only. It is not model compatibility or performance evidence, especially on software or virtual GPUs."
              )}
            </p>
          </div>
        </div>
      </div>

      <!-- Computer Control: browser connection and native macOS host. -->
      <div :if={@active_tab == :computer_use} class="settings-content-wrap">
        <div class="settings-content-card settings-form-section computer-control-settings">
          <div class="settings-section-heading">
            <div class="settings-section-title">{gettext("Computer Control")}</div>
            <div class="settings-help-text">
              {gettext(
                "Manage the browser connection and the native macOS capability available to this Agent."
              )}
            </div>
          </div>

          <div class="computer-control-group-label">{gettext("Browser")}</div>
          <div id="browser-extension-settings" class="settings-card">
            <div class="settings-field-row">
              <div class="settings-field-copy computer-control-product">
                <div class="computer-control-product-icon" aria-hidden="true">◎</div>
                <div>
                  <div class="settings-field-title">
                    {gettext("Google Chrome")}
                    <span class="settings-badge-experimental">
                      {cond do
                        !@browser_extension_status.supported -> gettext("Unavailable")
                        @browser_extension_status.extension_connected -> gettext("Connected")
                        @browser_extension_status.enabled -> gettext("Waiting for extension")
                        true -> gettext("Off")
                      end}
                    </span>
                  </div>
                  <div class="settings-field-desc">
                    {gettext(
                      "Connect Handbean to ordinary tabs in your current Chrome profile. Tabs are managed automatically while this switch is on; risky actions still use Handbean confirmations."
                    )}
                  </div>
                </div>
              </div>
              <div class="settings-field-control">
                <button
                  id="browser-extension-toggle"
                  type="button"
                  phx-click="toggle_chrome_browser"
                  disabled={!@browser_extension_status.supported}
                  class="settings-toggle-button speech-settings-toggle"
                  role="switch"
                  aria-checked={to_string(@browser_extension_status.enabled)}
                  aria-label={gettext("Enable Chrome extension connection")}
                >
                  <span class="settings-toggle-track" aria-hidden="true">
                    <span class="settings-toggle-thumb"></span>
                  </span>
                </button>
              </div>
            </div>

            <div
              :if={@browser_extension_status.enabled}
              class="settings-field-row computer-control-status-row"
            >
              <div class="settings-field-copy">
                <div class="settings-field-title">{gettext("Extension connection")}</div>
                <div class="computer-control-status-list">
                  <span>
                    {gettext("Relay:")}
                    <strong>
                      {if @browser_extension_status.relay_available,
                        do: gettext("Ready"),
                        else: gettext("Unavailable")}
                    </strong>
                  </span>
                  <span>
                    {gettext("Extension:")}
                    <strong>
                      {if @browser_extension_status.extension_connected,
                        do: gettext("Connected"),
                        else: gettext("Not connected")}
                    </strong>
                  </span>
                  <span>
                    {gettext("Available tabs:")}
                    <strong>{@browser_extension_status.controlled_tabs}</strong>
                  </span>
                  <span>
                    {gettext("agent-browser:")}
                    <strong>
                      <%= cond do %>
                        <% @browser_extension_status.agent_browser.compatible -> %>
                          {@browser_extension_status.agent_browser.version}
                        <% @browser_extension_status.agent_browser.available -> %>
                          {gettext("%{version} · upgrade required",
                            version: @browser_extension_status.agent_browser.version
                          )}
                        <% true -> %>
                          {gettext("Not found")}
                      <% end %>
                    </strong>
                  </span>
                </div>
                <div class="settings-field-desc computer-control-pairing-help">
                  {gettext(
                    "Load the unpacked extension from %{path}, then paste the pairing URL into its popup. Packaged desktop builds include the browser runtime.",
                    path: @browser_extension_status.extension_path
                  )}
                </div>
              </div>
              <div class="settings-field-control computer-control-browser-actions">
                <button
                  :if={@browser_extension_status.pairing_url}
                  id="browser-extension-copy-pairing"
                  type="button"
                  class="settings-btn"
                  phx-hook="CopyText"
                  data-copy={@browser_extension_status.pairing_url}
                >
                  {gettext("Copy pairing URL")}
                </button>
                <button
                  id="browser-extension-refresh"
                  type="button"
                  phx-click="refresh_chrome_browser_status"
                  class="settings-btn"
                >
                  {gettext("Refresh")}
                </button>
              </div>
            </div>
          </div>

          <div class="computer-control-group-label">{gettext("Desktop")}</div>
          <div id="computer-use-settings" class="settings-card">
            <div class="settings-field-row">
              <div class="settings-field-copy">
                <div class="settings-field-title">
                  {gettext("Enable computer control")}
                  <span class="settings-badge-experimental">
                    {if @computer_use_status.supported,
                      do: gettext("macOS native"),
                      else: gettext("Unavailable on this platform")}
                  </span>
                </div>
                <div class="settings-field-desc">
                  {gettext(
                    "Allows the Agent to observe and control one approved window for the current run. Approve the target once; Stop, run end, or two idle minutes revokes control."
                  )}
                </div>
              </div>
              <div class="settings-field-control">
                <button
                  id="computer-use-enabled-toggle"
                  type="button"
                  phx-click="toggle_computer_use"
                  disabled={!@computer_use_status.supported}
                  class="settings-toggle-button speech-settings-toggle"
                  role="switch"
                  aria-checked={to_string(@computer_use_status.enabled)}
                  aria-label={gettext("Enable computer control")}
                >
                  <span class="settings-toggle-track" aria-hidden="true">
                    <span class="settings-toggle-thumb"></span>
                  </span>
                </button>
              </div>
            </div>

            <div class="settings-field-row computer-control-status-row">
              <div class="settings-field-copy">
                <div class="settings-field-title">{gettext("macOS permissions")}</div>
                <div class="computer-control-status-list">
                  <span>
                    {gettext("Screen Recording")}
                    <strong>{computer_permission_label(
                      if is_map(@computer_use_status.permissions),
                        do: @computer_use_status.permissions.screen_recording,
                        else: :unknown
                    )}</strong>
                  </span>
                  <span>
                    {gettext("Accessibility")}
                    <strong>{computer_permission_label(
                      if is_map(@computer_use_status.permissions),
                        do: @computer_use_status.permissions.accessibility,
                        else: :unknown
                    )}</strong>
                  </span>
                  <span>
                    {gettext("Input control")}
                    <strong>{computer_permission_label(
                      if is_map(@computer_use_status.permissions),
                        do: @computer_use_status.permissions.event_post,
                        else: :unknown
                    )}</strong>
                  </span>
                </div>
              </div>
              <div class="settings-field-control">
                <button
                  id="computer-use-refresh"
                  type="button"
                  phx-click="refresh_computer_use_status"
                  disabled={!@computer_use_status.supported}
                  class="settings-btn"
                >
                  {gettext("Refresh")}
                </button>
              </div>
            </div>

            <div class="settings-field-row">
              <div class="settings-field-copy">
                <div class="settings-field-title">{gettext("Pointer input")}</div>
                <div class="settings-field-desc">
                  {gettext(
                    "Typing and supported keys are available. Click and scroll stay closed until real-device targeting acceptance passes."
                  )}
                </div>
              </div>
              <div class="settings-field-control">
                <span class="settings-badge-experimental">
                  {computer_action_label(@computer_use_status, "click")}
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div :if={@active_tab == :plugins} class="flex-1 overflow-hidden">
        {live_render(@socket, HandbeanWeb.PluginsSettingsLive,
          id: "settings-mcp",
          session: %{
            "workspace_id" => @workspace["id"],
            "workspace_name" => @workspace["name"],
            "workspace_root" => @workspace_root
          }
        )}
      </div>

      <div :if={@active_tab == :git} class="flex-1 overflow-hidden">
        {live_render(@socket, HandbeanWeb.GitSettingsLive, id: "settings-git")}
      </div>

      <!-- UI Settings Tab -->
      <div :if={@active_tab == :ui} class="settings-content-wrap">
        <div class="settings-content-card settings-form-section">
          <HandbeanWeb.Components.PWAInstall.render />
          <HandbeanWeb.Components.PushNotifications.render locale={@locale} />
          <div class="settings-form-section">
            <div class="settings-section-title">{gettext("UI Settings")}</div>
            <div class="settings-help-text">
              {gettext("Configure layout, language, and theme preferences.")}
            </div>

            <div class="settings-card">
              <div class="settings-field-row">
                <div class="settings-field-copy">
                  <div class="settings-field-title">{gettext("Language")}</div>
                  <div class="settings-field-desc">
                    {gettext("Choose the interface language.")}
                  </div>
                </div>
                <div class="settings-field-control">
                  <div class="settings-seg" role="group" aria-label={gettext("Language")}>
                    <button
                      id="ui-locale-zh_CN"
                      type="button"
                      phx-click="set_locale"
                      phx-value-locale="zh_CN"
                      class={[
                        "settings-chip no-underline inline-flex items-center justify-center text-xs px-3 py-1.5 rounded border transition-colors",
                        if(@locale == "zh_CN",
                          do: "active font-medium",
                          else: "text-secondary hover:bg-surface-hover"
                        )
                      ]}
                    >
                      {gettext("中文 (简体)")}
                    </button>
                    <button
                      id="ui-locale-en"
                      type="button"
                      phx-click="set_locale"
                      phx-value-locale="en"
                      class={[
                        "settings-chip no-underline inline-flex items-center justify-center text-xs px-3 py-1.5 rounded border transition-colors",
                        if(@locale == "en",
                          do: "active font-medium",
                          else: "text-secondary hover:bg-surface-hover"
                        )
                      ]}
                    >
                      {gettext("English")}
                    </button>
                  </div>
                </div>
              </div>
              <div class="settings-field-row">
                <div class="settings-field-copy">
                  <div class="settings-field-title">{gettext("Theme")}</div>
                  <div class="settings-field-desc">
                    {gettext("Light, dark, or follow the system.")}
                  </div>
                </div>
                <div class="settings-field-control">
                  <div id="theme-bridge" phx-hook="ThemeBridge" hidden></div>
                  <div class="settings-seg" role="group" aria-label={gettext("Theme")}>
                    <button
                      id="ui-theme-light"
                      type="button"
                      phx-click={theme_click("light")}
                      class={[
                        "settings-chip",
                        @theme == "light" && "active"
                      ]}
                    >
                      {gettext("Light")}
                    </button>
                    <button
                      id="ui-theme-dark"
                      type="button"
                      phx-click={theme_click("dark")}
                      class={[
                        "settings-chip",
                        @theme == "dark" && "active"
                      ]}
                    >
                      {gettext("Dark")}
                    </button>
                    <button
                      id="ui-theme-system"
                      type="button"
                      phx-click={theme_click("system")}
                      class={[
                        "settings-chip",
                        @theme == "system" && "active"
                      ]}
                    >
                      {gettext("System")}
                    </button>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
