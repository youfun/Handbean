# Handbean 本地 Web UI 默认配置
# 所有变量均可用环境变量覆盖

# 启用 HTTP server
export PHX_SERVER=true

# 端口
export PORT="${PORT:-5008}"

# 主机名（本地使用）
export PHX_HOST="${PHX_HOST:-localhost}"

# 数据库路径（与 models.json、workspaces.json 同目录 ~/.handbean/）
export DATABASE_PATH="${DATABASE_PATH:-$HOME/.handbean/handbean.db}"
export HANDBEAN_WORKSPACES_FILE="${HANDBEAN_WORKSPACES_FILE:-$HOME/.handbean/workspaces.json}"

# Release 运行状态和 daemon 日志必须放在内置磁盘。工作区或 release
# 位于可移除磁盘时，掉盘后的日志仍可用于诊断进程退出。
export HANDBEAN_RUNTIME_DIR="${HANDBEAN_RUNTIME_DIR:-$HOME/.handbean/runtime}"
umask 077
mkdir -p "$HANDBEAN_RUNTIME_DIR"
export RELEASE_TMP="${RELEASE_TMP:-$HANDBEAN_RUNTIME_DIR}"
export ERL_CRASH_DUMP="${ERL_CRASH_DUMP:-$HANDBEAN_RUNTIME_DIR/erl_crash.dump}"

# Session 密钥（优先复用环境变量，否则持久化到 ~/.handbean/secret_key_base，重启后保留会话与推送订阅）
handbean_secret_file="$HOME/.handbean/secret_key_base"
if [ -z "${SECRET_KEY_BASE:-}" ] && [ -s "$handbean_secret_file" ]; then
  IFS= read -r SECRET_KEY_BASE < "$handbean_secret_file" || true
  SECRET_KEY_BASE=$(printf '%s' "$SECRET_KEY_BASE" | tr -d '\r')
fi
if [ -z "${SECRET_KEY_BASE:-}" ]; then
  SECRET_KEY_BASE="$(openssl rand -base64 48 2>/dev/null || echo 'dev-fallback-not-for-production')"
  if [ "$SECRET_KEY_BASE" != "dev-fallback-not-for-production" ]; then
    mkdir -p "$HOME/.handbean"
    printf '%s\n' "$SECRET_KEY_BASE" > "$handbean_secret_file"
    chmod 600 "$handbean_secret_file"
  fi
fi
export SECRET_KEY_BASE

# 局域网访问（可选）：绑定所有网卡并允许明文 HTTP，局域网内其他设备可直接访问
# http://<本机IP>:$PORT，等价于 start.sh --lan / start.bat -LanHost。非回环
# 绑定强制密码认证，密码请改成长随机字符串；HTTP 不加密，仅限受信任网络。
# export HANDBEAN_PUBLIC_BIND=1
# export HANDBEAN_ALLOW_HTTP=1
# export HANDBEAN_ACCESS_MODE=password
# export HANDBEAN_ACCESS_PASSWORD="change-me-to-a-long-random-secret"
