# The directory Mix will write compiled artifacts to.
/_build/
/.build/
/mobile/.build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where 3rd-party dependencies like ExDoc output generated docs.
/doc/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Temporary files, for example, from tests.
/tmp/
tmp-config/
/tmp*
/.tmp*

# Local signing profiles
*.mobileprovision
test/fixtures/*
!test/fixtures/sample.txt

# Ignore package tarball (built via "mix hex.build").
handbea[mn]-*.tar

# Project-level model config (may contain API keys)
models.json
modejs.json

# Database files
*.db
*.db-*
*.db.lock
/node_modules/

# Generated Mix/Hex/ExUnit toolchain for mobile packaging
/priv/mix_toolchain/
/mobile/priv/mix_toolchain/
/priv/handbea[mn]_storage.so
/priv/handbea[mn]_darwin_process.so

# Build artifacts (generated by mix assets.build / mix assets.deploy)
/priv/static/assets/
/priv/static/cache_manifest.json
/priv/static/**/*-????????????????????????????????.*
/priv/static/**/*.gz
!/priv/static/uploads/

# macOS
.DS_Store
handbea[mn]-web-macos-*.tar.gz
handbea[mn]-web-macos-*.tar.gz.sha256

# Windows
handbea[mn]-web-windows-*.zip
handbea[mn]-web-windows-*.zip.sha256

# Local dev artifacts
test_rendered.html
mobile-ux-demo*.html

# MCP config (may contain API keys)
.mcp.json
.mcp.json.bak

# Local runtime data
.handbea[mn]/
.handbea[mn]-recovery/conversation-artifacts/
.playwright-mcp/

# Temporary screenshots / assets
terminal-*.png
/ios_verify_startup_error.png

# Local archive of retired documentation
/.local-archive/

# Editor / agent sidecar
.antigravitycli/
/.cursor/
