<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:style/Theme.NoTitleBar">
        <!-- Match NativeUI :surface (#FAF9F7). Black here is the whole first
             paint until BEAM mount + setRootJson, which reads as a dead screen. -->
        <item name="android:windowBackground">#FAF9F7</item>
        <item name="android:statusBarColor">#FAF9F7</item>
        <item name="android:navigationBarColor">#FAF9F7</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <!-- Android 15+ otherwise forces a transparent bar; this OEM then
             paints an opaque black strip. Opt out so statusBarColor applies. -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
