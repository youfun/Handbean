# Web Push notifications
#: lib/handbean_web/components/push_notifications.ex:20
#, elixir-autogen
msgid "推送通知"
msgstr "Push notifications"

#: lib/handbean_web/components/push_notifications.ex:23
#, elixir-autogen
msgid "在此浏览器接收任务完成和需要处理的提醒。每台设备需单独开启。"
msgstr "Receive alerts in this browser when tasks finish or need your attention. Enable notifications separately on each device."

#: lib/handbean_web/components/push_notifications.ex:24
#, elixir-autogen
msgid "通知尽力送达，服务器离线或重启期间可能错过提醒。"
msgstr "Delivery is best effort. You may miss alerts while the server is offline or restarting."

#: lib/handbean_web/components/push_notifications.ex:30
#, elixir-autogen
msgid "此浏览器的通知"
msgstr "Notifications for this browser"

#: lib/handbean_web/components/push_notifications.ex:32
#: lib/handbean_web/components/push_notifications.ex:55
#, elixir-autogen
msgid "正在检查通知支持…"
msgstr "Checking notification support…"

#: lib/handbean_web/components/push_notifications.ex:35
#: lib/handbean_web/components/push_notifications.ex:57
#, elixir-autogen
msgid "操作未完成，请检查网络与浏览器通知设置后重试。"
msgstr "The operation could not be completed. Check your connection and browser notification settings, then try again."

#: lib/handbean_web/components/push_notifications.ex:40
#, elixir-autogen
msgid "开启通知"
msgstr "Enable notifications"

#: lib/handbean_web/components/push_notifications.ex:43
#, elixir-autogen
msgid "关闭通知"
msgstr "Disable notifications"

#: lib/handbean_web/components/push_notifications.ex:46
#, elixir-autogen
msgid "发送测试通知"
msgstr "Send test notification"

#: lib/handbean_web/components/push_notifications.ex:56
#, elixir-autogen
msgid "关闭通知尚未完成，请重试以清理订阅。"
msgstr "Notifications have not been fully disabled. Retry to finish removing the subscription."

#: lib/handbean_web/components/push_notifications.ex:59
#, elixir-autogen
msgid "此订阅属于之前的浏览器会话，请先关闭通知，再重新开启。"
msgstr "This subscription belongs to a previous browser session. Disable notifications, then enable them again."

#: lib/handbean_web/components/push_notifications.ex:62
#, elixir-autogen
msgid "通知订阅已过期，请点击开启通知重新连接此浏览器。"
msgstr "The notification subscription has expired. Enable notifications to reconnect this browser."

#: lib/handbean_web/components/push_notifications.ex:64
#, elixir-autogen
msgid "通知订阅数量已达上限，请关闭其他设备的通知后重试。"
msgstr "The notification subscription limit has been reached. Disable notifications on another device, then try again."

#: lib/handbean_web/components/push_notifications.ex:65
#, elixir-autogen
msgid "订阅保存失败，浏览器订阅尚未清理，请点击关闭通知重试。"
msgstr "The subscription could not be saved or removed from this browser. Click Disable notifications to retry cleanup."

#: lib/handbean_web/components/push_notifications.ex:66
#, elixir-autogen
msgid "正在更新通知设置…"
msgstr "Updating notification settings…"

#: lib/handbean_web/components/push_notifications.ex:67
#, elixir-autogen
msgid "通知已关闭。点击开启后，浏览器会请求通知权限。"
msgstr "Notifications are off. Click Enable notifications to grant permission in your browser."

#: lib/handbean_web/components/push_notifications.ex:68
#, elixir-autogen
msgid "此浏览器已开启通知。"
msgstr "Notifications are enabled for this browser."

#: lib/handbean_web/components/push_notifications.ex:69
#, elixir-autogen
msgid "测试通知已发送，请检查系统通知。"
msgstr "The test notification was sent. Check your system notifications."

#: lib/handbean_web/components/push_notifications.ex:71
#, elixir-autogen
msgid "通知权限已被拒绝，请在浏览器的站点设置中允许通知后刷新页面。"
msgstr "Notification permission was denied. Allow notifications in your browser's site settings, then refresh this page."

#: lib/handbean_web/components/push_notifications.ex:73
#, elixir-autogen
msgid "尚未授予通知权限，可以再次点击开启通知。"
msgstr "Notification permission has not been granted. You can click Enable notifications again."

#: lib/handbean_web/components/push_notifications.ex:74
#, elixir-autogen
msgid "推送通知需要 HTTPS 安全连接（本机 localhost 除外）。"
msgstr "Push notifications require a secure HTTPS connection, except on localhost."

#: lib/handbean_web/components/push_notifications.ex:75
#, elixir-autogen
msgid "此浏览器不支持推送通知，请使用支持 Web Push 的浏览器。"
msgstr "This browser does not support push notifications. Use a browser that supports Web Push."

#: lib/handbean_web/components/push_notifications.ex:77
#, elixir-autogen
msgid "在 iPhone 或 iPad 上，请在 Safari 中选择“分享”→“添加到主屏幕”，再从主屏幕打开 Handbean 开启通知。"
msgstr "On iPhone or iPad, choose Share → Add to Home Screen in Safari, then open Handbean from your Home Screen to enable notifications."

#: lib/handbean_web/components/push_notifications.ex:80
#, elixir-autogen
msgid "服务器尚未配置推送通知，请联系管理员配置 Web Push 联系地址。"
msgstr "Push notifications are not configured on this server. Ask your administrator to configure the Web Push contact address."

#: lib/handbean_web/components/push_notifications.ex:82
#, elixir-autogen
msgid "通知配置已更新，请点击开启通知重新连接此浏览器。"
msgstr "The notification configuration has changed. Enable notifications to reconnect this browser."

